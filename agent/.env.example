# Which reply engine to use. "mock" is a scripted stand-in that needs no key
# and no network — the default while prototyping. Add a real provider in
# agent/lib/provider.js and set its name here to go live.
AGENT_PROVIDER=mock

# Your model provider's key. Not needed while AGENT_PROVIDER=mock.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Must match the backend's values — this module verifies the same sessions.
GOOGLE_CLIENT_ID=
JWT_SECRET=

# Frontend origin allowed to call this API (e.g. https://sahaya2.vercel.app).
ALLOWED_ORIGIN=
