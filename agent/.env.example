# Which reply engine to use.
#   mock       scripted stand-in — no key, no network, no model. The default.
#   anthropic  Claude, via the official SDK. Needs ANTHROPIC_API_KEY below.
#   cerebras   Cerebras, free tier. Needs CEREBRAS_API_KEY below.
#   gemini     Google Gemini, free tier. Needs GEMINI_API_KEY below.
# Anything else is an error: names are looked up in PROVIDERS in
# agent/lib/provider.js, which is also where you'd add another one.
AGENT_PROVIDER=mock

# Required when AGENT_PROVIDER=anthropic, ignored otherwise.
# console.anthropic.com > API keys.
# ANTHROPIC_API_KEY=

# Required when AGENT_PROVIDER=cerebras, ignored otherwise.
# cloud.cerebras.ai > API keys. The free tier needs no card and, unlike most
# free tiers, Cerebras states it does not retain prompts or responses and does
# not train on them — which is why it is the free option offered here.
# CEREBRAS_API_KEY=

# Optional. Overrides the model, because the free-tier list is Cerebras's to
# change and a model id baked into source becomes a 404 the day one retires.
# Free tier at time of writing: gemma-4-31b (default), gpt-oss-120b.
# gpt-oss-120b is a reasoning model — its thinking counts against the reply
# budget, so raise MAX_COMPLETION_TOKENS in lib/cerebras.js if you switch.
# CEREBRAS_MODEL=gemma-4-31b

# Required when AGENT_PROVIDER=gemini, ignored otherwise.
# aistudio.google.com > Get API key. The free tier needs no card and allows
# 15 requests a minute and 1500 a day. Note that, unlike Cerebras, Google's
# free tier does use prompts and responses to improve its products — which is
# the trade being made by picking this one for a mental-health app.
# GEMINI_API_KEY=

# Optional. Overrides the model, for the same reason as CEREBRAS_MODEL: the
# free-tier list is Google's to change.
# GEMINI_MODEL=gemini-3.6-flash

# Must match the backend's values — this module verifies the same sessions.
GOOGLE_CLIENT_ID=
JWT_SECRET=

# Frontend origin allowed to call this API (e.g. https://sahaya2.vercel.app).
ALLOWED_ORIGIN=
