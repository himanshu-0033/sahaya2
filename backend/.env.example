# Auto-filled by Vercel when you attach a KV (Upstash Redis) storage to this
# project. Leave unset for local dev — falls back to a local JSON file.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret the caregiver dashboard must send as the x-caregiver-key
# header. Leave unset locally to skip auth during development.
CAREGIVER_ACCESS_KEY=

# Frontend origin allowed to call this API (e.g. https://sahay-frontend.vercel.app).
# Leave unset (defaults to *) while developing locally.
ALLOWED_ORIGIN=
