# Auto-filled by Vercel when you connect a MongoDB Atlas (or other Mongo)
# database to this project via the Storage tab, using the default
# "STORAGE" prefix. Leave unset for local dev — falls back to a local
# JSON file at .data/db.json.
STORAGE_URL=

# OAuth Client ID from Google Cloud Console (APIs & Services > Credentials).
# Must match the frontend's VITE_GOOGLE_CLIENT_ID exactly — this is what
# Google ID tokens are checked against.
GOOGLE_CLIENT_ID=

# Random secret used to sign email/password session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated allowlist of Google account emails allowed to view the
# caregiver dashboard, e.g. warden@hostel.edu,counsellor@hostel.edu
# Leave unset to allow any signed-in Google account (fine for local dev only).
CAREGIVER_EMAILS=

# Comma-separated allowlist of accounts allowed into the counsellor/admin
# console (the admin/ module), e.g. counsellor@hostel.edu,dean@hostel.edu
# Falls back to CAREGIVER_EMAILS when unset; leave both unset to allow any
# signed-in account (fine for local dev only).
ADMIN_EMAILS=

# Origins allowed to call this API, comma-separated — the resident app and
# the admin console deploy separately, so BOTH must be listed here. If the
# admin console's origin is missing, the browser blocks every response and
# the console reports "Failed to fetch" as if the backend were down.
# An entry may use one `*` wildcard so Vercel preview URLs keep working:
# https://sahaya2.vercel.app,https://sahay-admin.vercel.app,https://*.vercel.app
# Leave unset (defaults to *) while developing locally.
ALLOWED_ORIGIN=

# Firebase service-account credentials, used only to verify the ID token the
# browser gets back after a phone number passes Firebase's SMS check.
# Firebase console > Project settings > Service accounts > "Generate new
# private key" downloads a JSON file; copy these three fields out of it.
# FIREBASE_PRIVATE_KEY must keep its literal \n sequences and be wrapped in
# double quotes — paste it as one line, newlines and all, exactly as the JSON
# has it. Leave all three unset to disable phone sign-in.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
