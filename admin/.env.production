# Build-time config for production — see the note in frontend/.env.production.
VITE_API_URL=https://sahaya2-72x2.vercel.app

# Public by design: an OAuth Client ID is sent to every browser that loads the
# console, and Google enforces the authorized-origins list, not secrecy. It is
# here because it was absent from the deployed bundle, which is why the
# "Continue with Google" button never rendered on the console.
VITE_GOOGLE_CLIENT_ID=634595323711-ve0cu56qm0o41gsu802ht88esgvsi3b5.apps.googleusercontent.com
