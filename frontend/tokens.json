      "paths-deep":   { "$value": "{primitive.color.form.spot}",   "$type": "color" },
      "calm-deep":    { "$value": "{primitive.color.form.spot}",   "$type": "color" },
      "tests-deep":   { "$value": "{primitive.color.form.spot}",   "$type": "color" },
      "inkblot-deep": { "$value": "{primitive.color.form.spot}",   "$type": "color" },
      "read-deep":    { "$value": "{primitive.color.form.spot}",   "$type": "color" }
