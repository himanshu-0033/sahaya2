      "amber-deep":    { "$value": "{primitive.color.amber.700}", "$type": "color" },
      "rose-deep":     { "$value": "{primitive.color.pink.600}",  "$type": "color" }
    },

    "sec": {
      "home":    { "$value": "{primitive.color.form.spot}",   "$type": "color" },
