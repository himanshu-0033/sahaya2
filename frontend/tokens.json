    "surface": {
      "1": { "$value": "rgb(var(--primitive-channel-ink) / 0.03)", "$type": "color" },
      "2": { "$value": "rgb(var(--primitive-channel-ink) / 0.05)", "$type": "color" },
      "3": { "$value": "rgb(var(--primitive-channel-ink) / 0.08)", "$type": "color" },
      "4": { "$value": "rgb(var(--primitive-channel-ink) / 0.10)", "$type": "color" },
      "5": { "$value": "rgb(var(--primitive-channel-ink) / 0.15)", "$type": "color" }
    },

    "line": {
      "1": { "$value": "rgb(var(--primitive-channel-ink) / 0.08)", "$type": "color" },
      "2": { "$value": "rgb(var(--primitive-channel-ink) / 0.11)", "$type": "color" },
      "3": { "$value": "rgb(var(--primitive-channel-ink) / 0.15)", "$type": "color" },
      "4": { "$value": "rgb(var(--primitive-channel-ink) / 0.24)", "$type": "color" },
      "5": { "$value": "rgb(var(--primitive-channel-ink) / 0.30)", "$type": "color" },
      "6": { "$value": "rgb(var(--primitive-channel-ink) / 0.40)", "$type": "color" },
      "7": { "$value": "rgb(var(--primitive-channel-ink) / 0.60)", "$type": "color" }
    },

    "ink": {
      "faint":       { "$value": "rgb(var(--primitive-channel-ink) / 0.35)",   "$type": "color" }
