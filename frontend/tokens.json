      "teal-dark":     { "$value": "{primitive.color.form.spot-deep}", "$type": "color" },
      "teal-soft":     { "$value": "rgb(var(--primitive-channel-sage) / 0.1)",   "$type": "color" },
      "amber":         { "$value": "{primitive.color.amber.400}","$type": "color" },
      "lavender":      { "$value": "{primitive.color.violet.400}","$type": "color" },
