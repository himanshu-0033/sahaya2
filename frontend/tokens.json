    "channel": {
      "ink":   { "$value": "15 36 25",    "$type": "color" },
      "paper": { "$value": "255 255 255", "$type": "color" },
      "sage":  { "$value": "10 92 50",    "$type": "color" },
      "violet":{ "$value": "167 156 240", "$type": "color" },
