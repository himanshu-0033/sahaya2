# Build-time config for production. Vite inlines VITE_* values when `vite build`
# runs, so anything missing here is missing from the bundle forever — setting it
# afterwards does nothing until the app is rebuilt.
#
# Committed rather than left to the Vercel dashboard because the failure is
# silent-ish and hard to read: with no VITE_API_URL the client falls back to a
# relative path, calls the frontend's own origin, and every page reports
# "Request failed (404)" while the backend is perfectly healthy.
#
# A Vercel environment variable of the same name still wins over this file, so
# nothing here blocks overriding it per-environment later.
VITE_API_URL=https://sahaya2-72x2.vercel.app
