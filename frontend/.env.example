# Base URL of the deployed backend, e.g. https://sahaya2-72x2.vercel.app
# Leave empty for local dev when using the Vite proxy in vite.config.js.
VITE_API_URL=

# OAuth Client ID from Google Cloud Console (APIs & Services > Credentials).
# Must match the backend's GOOGLE_CLIENT_ID exactly.
#
# The same client also has to list every origin the app is served from under
# "Authorised JavaScript origins" — http://localhost:5173 for local dev, plus
# the deployed URL. An origin that is not on that list fails sign-in with
# "Error 400: origin_mismatch", which looks like a bad client id and is not.
VITE_GOOGLE_CLIENT_ID=
