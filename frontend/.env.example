# Base URL of the deployed backend, e.g. https://sahaya2-72x2.vercel.app
# Leave empty for local dev when using the Vite proxy in vite.config.js.
VITE_API_URL=

# OAuth Client ID from Google Cloud Console (APIs & Services > Credentials).
# Must match the backend's GOOGLE_CLIENT_ID exactly.
VITE_GOOGLE_CLIENT_ID=

# Firebase web-app config, used only for phone (SMS OTP) sign-in.
# Firebase console > Project settings > General > "Your apps" > Web app.
# These are public by design — the account is protected by the authorized
# domains list and reCAPTCHA, not by hiding the key.
# Leave unset to hide phone sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
