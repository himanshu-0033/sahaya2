*.sw?
agent/.data

# Firebase service-account keys — the console downloads these as a JSON file
# with a name like my-project-firebase-adminsdk-ab12c-3d4e5f6a7b.json.
# Copy the three fields you need into .env.local instead of committing it.
*firebase-adminsdk*.json
serviceAccountKey.json

# Source questionnaire forms. Kept locally to transcribe wording from, but
# they are published third-party documents rather than part of this codebase —
# instruments.js carries the wording, its licence and its citation.
*.pdf

.vercel

# Secrets only. .env.example and .env.production are committed on purpose —
# the examples document what each module needs, and .env.production carries
# the public build config (VITE_API_URL, VITE_AGENT_URL) that the Vercel build
# reads. Without these negations a bare `.env*` swallows both, and the day one
# is re-added it disappears instead.
.env*
!.env.example
!.env.production

# ------------------------------------------------------------------
# AI assistant and editor config
#
# Every tool that has been pointed at this repo drops a directory in the
# root — nineteen of them at last count. None is part of the app: they are
# local prompt libraries, agent definitions and editor state, they differ
# per machine and per person, and a diff full of them buries the diff of
# the actual change.
#
# Listed one per line rather than caught by a glob. A pattern loose enough
# to match all of these would also match .github and .gitignore, and the
# day someone adds a real dotfile it would vanish without a word.
.agents/
.augment/
.claude/
.codebuddy/
.codewhale/
.continue/
.cursor/
.factory/
.gemini/
.kilocode/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.warp/
.windsurf/

# .github holds only a prompt library here, but it is also where GitHub
# workflows, issue templates and CODEOWNERS belong. Ignoring the whole
# directory would swallow the first workflow anybody adds, silently — so
# only the prompts are ignored, and real GitHub config still commits.
.github/prompts/
